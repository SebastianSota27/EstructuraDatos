#include <iostream>
#include <fstream>
using namespace std;

struct Proceso {
    int id;
    string nombre;
    string prioridad;
    int memoria;
    string estado;
};

struct Nodo {
    Proceso entrada;
    Nodo* sig;
};

Nodo* listaGeneral = NULL;                  // Cabeza de la Lista General
Nodo* primeroCPU = NULL, *ultimoCPU = NULL; // Punteros para la Cola de CPU
Nodo* topeHistorial = NULL;                 // Puntero para la Pila Historial

// OPERACIONES DE LA LISTA ENLAZADA SIMPLE

void registrarProceso() {
    int idBuscar;
    cout << "Ingrese el ID del proceso (Numero entero): ";
    cin >> idBuscar;

    Nodo* aux = listaGeneral;
    while (aux != NULL) {
        if (aux->entrada.id == idBuscar) {
            cout << "Error: Este ID ya existe. Intente con otro." << endl;
            return;
        }
        aux = aux->sig;
    }

    Nodo* nuevo = new Nodo();
    nuevo->entrada.id = idBuscar;

    cout << "Ingrese Nombre del proceso: ";
    cin.ignore();
	getline(cin, nuevo->entrada.nombre);

    cout << "Ingrese Prioridad (Alta, Media, Baja): ";
    cin >> nuevo->entrada.prioridad;

    cout << "Ingrese cantidad de memoria (KB): ";
    cin >> nuevo->entrada.memoria;

    nuevo->entrada.estado = "Listo"; // Todo proceso inicia en listo

    // Insertar al inicio de la lista enlazada simple
    nuevo->sig = listaGeneral;
    listaGeneral = nuevo;

    cout << "Proceso registrado en la lista con exito." << endl;
}

void mostrarListaGeneral() {
    if (listaGeneral == NULL) {
        cout << "La lista general esta vacia." << endl;
        return;
    }
    
    Nodo* aux = listaGeneral;
    cout << "\n--- LISTA GENERAL DE PROCESOS ---" << endl;
    while (aux != NULL) {
        cout << "ID: " << aux->entrada.id 
             << " | Nombre: " << aux->entrada.nombre 
             << " | Prio: " << aux->entrada.prioridad 
             << " | Memoria: " << aux->entrada.memoria << " KB"
             << " | Estado: " << aux->entrada.estado << endl;
        aux = aux->sig;
    }
}

void buscarProceso() {
    if (listaGeneral == NULL) {
        cout << "No hay procesos registrados para buscar." << endl;
        return;
    }
    int modo;
    cout << "1. Buscar por ID | 2. Buscar por Nombre: ";
    cin >> modo;

    Nodo* aux = listaGeneral;
    bool encontrado = false;

    if (modo == 1) {
        int idB; cout << "Ingrese ID a buscar: "; cin >> idB;
        while (aux != NULL) {
            if (aux->entrada.id == idB) {
                cout << "Encontrado -> Nombre: " << aux->entrada.nombre << " | Estado: " << aux->entrada.estado << endl;
                encontrado = true;
                break;
            }
            aux = aux->sig;
        }
    } else {
        string nomB; cout << "Ingrese Nombre a buscar: "; cin >> nomB;
        while (aux != NULL) {
            if (aux->entrada.nombre == nomB) {
                cout << "Encontrado -> ID: " << aux->entrada.id << " | Estado: " << aux->entrada.estado << endl;
                encontrado = true;
            }
            aux = aux->sig;
        }
    }
    if (!encontrado) cout << "Proceso no encontrado." << endl;
}

void modificarPrioridad() {
    int idB;
    cout << "Ingrese ID del proceso a modificar: ";
    cin >> idB;

    Nodo* aux = listaGeneral;
    while (aux != NULL) {
        if (aux->entrada.id == idB) {
            cout << "Prioridad actual: " << aux->entrada.prioridad << endl;
            cout << "Ingrese nueva prioridad (Alta, Media, Baja): ";
            cin >> aux->entrada.prioridad;
            cout << "Prioridad cambiada correctamente." << endl;
            return;
        }
        aux = aux->sig;
    }
    cout << "No se encontro el proceso." << endl;
}

void eliminarProceso() {
    int idB;
    cout << "Ingrese ID del proceso a eliminar: ";
    cin >> idB;

    Nodo* actual = listaGeneral;
    Nodo* anterior = NULL;

    while (actual != NULL && actual->entrada.id != idB) {
        anterior = actual;
        actual = actual->sig;
    }

    if (actual == NULL) {
        cout << "Proceso no encontrado." << endl;
        return;
    }

    if (anterior == NULL) { 
        listaGeneral = listaGeneral->sig;
    } else {
        anterior->sig = actual->sig;
    }

    cout << "Proceso " << actual->entrada.nombre << " eliminado de la lista." << endl;
    delete actual; // liberar memoria
}

// OPERACIONES DE LA COLA

void enviarAColaCPU() {
    Nodo* aux = listaGeneral;
    int contador = 0;

    while (aux != NULL) {
        if (aux->entrada.estado == "Listo") {
            
            Nodo* nuevoNodo = new Nodo();
            nuevoNodo->entrada = aux->entrada;
            nuevoNodo->sig = NULL;

            if (primeroCPU == NULL) { 
                primeroCPU = ultimoCPU = nuevoNodo;
            } 
            else if (nuevoNodo->entrada.prioridad == "Alta" && primeroCPU->entrada.prioridad != "Alta") {
                //nuevo proceso es de prioridad alta va al frente de la cola
                nuevoNodo->sig = primeroCPU;
                primeroCPU = nuevoNodo;
            } 
            else {
                //se encola al final respetando el orden de llegada -> FIFO
                ultimoCPU->sig = nuevoNodo;
                ultimoCPU = nuevoNodo;
            }

            aux->entrada.estado = "En Espera"; // Modificamos el estado en la lista base
            contador++;
        }
        aux = aux->sig;
    }
    cout << "Se enviaron " << contador << " procesos a la Cola de CPU." << endl;
}

void mostrarColaCPU() {
    if (primeroCPU == NULL) {
        cout << "La cola de CPU esta vacia." << endl;
        return;
    }
    Nodo* aux = primeroCPU;
    cout << "\n--- COLA DE PLANIFICACIÓN DEL CPU ---" << endl;
    while (aux != NULL) {
        cout << "[ID: " << aux->entrada.id << " | Proceso: " << aux->entrada.nombre 
             << " | Prioridad: " << aux->entrada.prioridad << "]" << endl;
        aux = aux->sig;
    }
}

void ejecutarEnCPU() {
    if (primeroCPU == NULL) {
        cout << "No hay procesos en la cola para ejecutar." << endl;
        return;
    }

    // Desencola el nodo que está al frente de la cola
    Nodo* temp = primeroCPU;
    Proceso procesoEjecutado = temp->entrada;
    
    primeroCPU = primeroCPU->sig;
    if (primeroCPU == NULL) {
        ultimoCPU = NULL;
    }
    delete temp;

    cout << ">> [CPU] Ejecutando: " << procesoEjecutado.nombre << "..." << endl;
    cout << "Proceso terminado exitosamente." << endl;

    //modifica su estado en la lista general a finalizado
    Nodo* aux = listaGeneral;
    while (aux != NULL) {
        if (aux->entrada.id == procesoEjecutado.id) {
            aux->entrada.estado = "Finalizado";
            break;
        }
        aux = aux->sig;
    }

    //apilar en el Historial de memoria -> pila LIFO
    Nodo* nuevoNodoPila = new Nodo();
    nuevoNodoPila->entrada = procesoEjecutado;
    
    // Insertar arriba en la pila osea apilar
    nuevoNodoPila->sig = topeHistorial;
    topeHistorial = nuevoNodoPila;
}

// OPERACIONES DE LA PILA - HISTORIAL

void mostrarHistorialPila() {
    if (topeHistorial == NULL) {
        cout << "El historial de memoria liberada esta vacio." << endl;
        return;
    }
    Nodo* aux = topeHistorial;
    cout << "\n--- HISTORIAL DE MEMORIA LIBERADA (PILA LIFO) ---" << endl;
    while (aux != NULL) {
        cout << "<- [ID: " << aux->entrada.id << " | Nombre: " << aux->entrada.nombre 
             << " | Memoria Liberada: " << aux->entrada.memoria << " KB]" << endl;
        aux = aux->sig;
    }
}

void desapilarHistorial() {
    if (topeHistorial == NULL) {
        cout << "La pila del historial ya esta vacia." << endl;
        return;
    }
    Nodo* temp = topeHistorial;
    cout << "Quitando de la cima de la Pila -> Registro de: " << temp->entrada.nombre << endl;
    topeHistorial = topeHistorial->sig; // El tope se mueve al nodo de abajo
    delete temp;                        // Borra el antiguo nodo superior
}

//Guardado de datos

void guardarEnArchivo() {
    ofstream archivo("datos.txt"); //abrir el archivo datos.txt
    if (!archivo) {
        cout << "Error al generar el archivo de persistencia." << endl;
        return;
    }

    Nodo* temp = listaGeneral;
    while (temp != NULL) {
        archivo << temp->entrada.id << " "
                << temp->entrada.nombre << " "
                << temp->entrada.prioridad << " "
                << temp->entrada.memoria << " "
                << temp->entrada.estado << "\n";
        temp = temp->sig;
    }
    archivo.close();
    cout << "Datos del sistema respaldados exitosamente en 'datos.txt'." << endl;
}

void cargarDesdeArchivo() {
    ifstream archivo("datos.txt");
    if (!archivo) {
        cout << "No hay archivo previo, iniciando sistema en limpio" << endl;
        return;
    }

    int id, memoria;
    string nombre, prioridad, estado;

    //leer los datos directamente respetando las variables
    while (archivo >> id >> nombre >> prioridad >> memoria >> estado) {
        Nodo* nuevo = new Nodo();
        nuevo->entrada.id = id;
        nuevo->entrada.nombre = nombre;
        nuevo->entrada.prioridad = prioridad;
        nuevo->entrada.memoria = memoria;
        nuevo->entrada.estado = estado;

        nuevo->sig = listaGeneral;
        listaGeneral = nuevo;
    }
    archivo.close();
    cout << "¡Estructuras cargadas correctamente desde 'datos.txt'!" << endl;
}

